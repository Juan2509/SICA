<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="app-root">
 <top><HBox alignment="CENTER_LEFT" spacing="15" styleClass="screen-header"><padding><Insets top="18" right="30" bottom="18" left="30"/></padding><Button text="Volver" onAction="#volver" styleClass="secondary-button"/><VBox><Label text="Control de acceso" styleClass="page-title"/><Label text="Consulta la autorización antes de registrar una entrada o salida" styleClass="page-subtitle"/></VBox></HBox></top>
 <center><VBox spacing="18" styleClass="screen-content"><padding><Insets top="22" right="28" bottom="24" left="28"/></padding><HBox spacing="18"><VBox prefWidth="380" spacing="10" styleClass="form-card"><Label text="Identificar persona" styleClass="card-title"/><Label text="Documento" styleClass="field-label"/><HBox spacing="8"><TextField fx:id="documentoField" promptText="Documento del visitante o trabajador" HBox.hgrow="ALWAYS" styleClass="login-field"/><Button fx:id="buscarButton" text="Buscar" onAction="#buscar" styleClass="secondary-button"/></HBox><Button fx:id="checkinButton" text="Permitir ingreso · Check-in" onAction="#checkin" maxWidth="Infinity" styleClass="primary-button"/><Button fx:id="checkoutButton" text="Registrar salida · Check-out" onAction="#checkout" maxWidth="Infinity" styleClass="secondary-button"/><Label fx:id="mensajeLabel" wrapText="true"/></VBox><VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="form-card"><Label text="Validación de la visita" styleClass="card-title"/><VBox spacing="10" styleClass="detail-panel"><Label fx:id="nombreLabel" text="Persona sin consultar" styleClass="info-title"/><Label fx:id="anfitrionLabel" text="Visita a: -" styleClass="info-text"/><Label fx:id="estadoLabel" text="Estado de autorización: -" styleClass="request-status"/><Label text="URL de fotografía" styleClass="field-label"/><Hyperlink fx:id="fotoLink" text="Fotografía: -" wrapText="true"/></VBox><Label text="Una solicitud pendiente o rechazada no permite realizar check-in." wrapText="true" styleClass="page-subtitle"/></VBox></HBox><VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="table-card"><HBox alignment="CENTER_LEFT"><Label text="Personas actualmente dentro" styleClass="card-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Actualizar" onAction="#actualizarDentro" styleClass="secondary-button"/></HBox><TableView fx:id="dentroTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="nombreColumn" text="Nombre"/><TableColumn fx:id="documentoColumn" text="Documento"/><TableColumn fx:id="tipoColumn" text="Tipo"/><TableColumn fx:id="entradaColumn" text="Hora de entrada"/></columns></TableView></VBox></VBox></center>
</BorderPane>
