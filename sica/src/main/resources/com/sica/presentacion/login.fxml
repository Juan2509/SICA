<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           styleClass="login-root">
    <padding>
        <Insets top="46" right="56" bottom="46" left="56"/>
    </padding>

    <HBox maxWidth="830" maxHeight="500" styleClass="login-card">
        <VBox prefWidth="350" spacing="18" styleClass="brand-panel">
            <padding>
                <Insets top="62" right="42" bottom="52" left="42"/>
            </padding>
            <Label text="SICA" styleClass="brand-title"/>
            <Label text="Sistema Integrado de Control de Acceso"
                   wrapText="true" styleClass="brand-subtitle"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="ZONA ACME" styleClass="brand-badge"/>
            <Label text="Seguridad, control y trazabilidad en un solo lugar."
                   wrapText="true" styleClass="brand-description"/>
        </VBox>

        <VBox prefWidth="480" spacing="12" styleClass="form-panel">
            <padding>
                <Insets top="52" right="56" bottom="45" left="56"/>
            </padding>
            <Label text="Bienvenido" styleClass="form-title"/>
            <Label text="Ingresa tus credenciales para continuar"
                   styleClass="form-subtitle"/>
            <Region prefHeight="14"/>
            <Label text="Usuario" styleClass="field-label"/>
            <TextField fx:id="usuarioField" promptText="Ej. admin"
                       styleClass="login-field"/>
            <Label text="Contraseña" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="Tu contraseña"
                           onAction="#iniciarSesion" styleClass="login-field"/>
            <Label fx:id="mensajeLabel" text="" visible="false"
                   managed="true" wrapText="true" styleClass="error-label"/>
            <Region prefHeight="4"/>
            <Button fx:id="ingresarButton" text="INICIAR SESIÓN"
                    onAction="#iniciarSesion" maxWidth="Infinity"
                    defaultButton="true" styleClass="primary-button"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Acceso exclusivo para personal autorizado"
                   styleClass="form-footer"/>
        </VBox>
    </HBox>
</StackPane>
