<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="app-root">
    <left>
        <VBox prefWidth="250" spacing="8" styleClass="sidebar">
            <padding><Insets top="30" right="22" bottom="25" left="22"/></padding>
            <Label text="SICA" styleClass="sidebar-logo"/>
            <Label text="ZONA ACME" styleClass="sidebar-company"/>
            <Region prefHeight="24"/>
            <Button text="Inicio" onAction="#mostrarInicio" maxWidth="Infinity" styleClass="nav-button-active"/>
            <Button fx:id="usuariosButton" text="Usuarios" onAction="#seleccionarModulo" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="rolesButton" text="Roles y permisos" onAction="#seleccionarModulo" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="personasButton" text="Personas" onAction="#seleccionarModulo" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="empresasButton" text="Empresas" onAction="#seleccionarModulo" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="visitasButton" text="Visitas" onAction="#seleccionarModulo" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="accesoButton" text="Control de acceso" onAction="#seleccionarModulo" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="solicitudesButton" text="Solicitudes" onAction="#seleccionarModulo" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="incidentesButton" text="Incidentes" onAction="#seleccionarModulo" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="auditoriaButton" text="Auditoria" onAction="#seleccionarModulo" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="reportesButton" text="Reportes" onAction="#seleccionarModulo" maxWidth="Infinity" styleClass="nav-button"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Cerrar sesion" onAction="#cerrarSesion" maxWidth="Infinity" styleClass="logout-button"/>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
            <padding><Insets top="18" right="28" bottom="18" left="32"/></padding>
            <VBox spacing="3">
                <Label text="Panel principal" styleClass="page-title"/>
                <Label text="Menu configurado mediante RBAC" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="nombreUsuarioLabel" styleClass="user-name"/>
                <Label fx:id="rolUsuarioLabel" styleClass="user-role"/>
            </VBox>
            <Label fx:id="inicialesLabel" styleClass="avatar"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="22" styleClass="content-area">
            <padding><Insets top="34" right="38" bottom="34" left="38"/></padding>
            <Label fx:id="tituloContenidoLabel" text="Sesion iniciada correctamente" styleClass="welcome-title"/>
            <Label fx:id="descripcionContenidoLabel" text="Selecciona una opcion del menu lateral para comenzar."
                   wrapText="true" styleClass="welcome-subtitle"/>
            <HBox spacing="18">
                <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="summary-card">
                    <Label text="SEGURIDAD" styleClass="card-caption"/>
                    <Label text="Permisos en PostgreSQL" styleClass="card-title"/>
                    <Label text="Las opciones visibles provienen de los permisos asociados a tu rol."
                           wrapText="true" styleClass="card-description"/>
                </VBox>
                <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="summary-card">
                    <Label text="NAVEGACION" styleClass="card-caption"/>
                    <Label text="Menu personalizado" styleClass="card-title"/>
                    <Label text="Cada usuario observa solamente las capacidades que tiene autorizadas."
                           wrapText="true" styleClass="card-description"/>
                </VBox>
            </HBox>
            <VBox spacing="10" styleClass="info-panel">
                <Label text="Acceso configurado mediante RBAC" styleClass="info-title"/>
                <Label fx:id="cantidadModulosLabel" text="Consultando permisos del rol..."
                       wrapText="true" styleClass="info-text"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
